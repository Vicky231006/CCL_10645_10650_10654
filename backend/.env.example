# Resumo backend environment template — copy to backend/.env and fill in.
# NEVER commit a real .env.

# --- Core ---
APP_ENV=development
DEBUG=true
APP_NAME=Resumo
FRONTEND_ORIGIN=http://localhost:5173

# --- Security ---
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-development-only-secret-key
ACCESS_TOKEN_TTL_MINUTES=720
COOKIE_SECURE=false
COOKIE_DOMAIN=

# --- Database ---
# Local default is SQLite with zero setup. For Postgres (prod/RDS) use:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/resumo
DATABASE_URL=sqlite:///./resumo_dev.db

# --- Storage ---
# local | s3
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage
S3_BUCKET=
S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- AI provider ---
# ollama | openai | bedrock | none
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
BEDROCK_REGION=ap-south-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
LLM_TIMEOUT_SECONDS=120

# --- Uploads ---
MAX_UPLOAD_MB=10
MAX_PDF_PAGES=10

# --- Background jobs ---
# inline | thread | sqs
JOB_RUNNER=thread
SQS_QUEUE_URL=
