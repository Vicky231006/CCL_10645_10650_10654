# Resumo — environment configuration for docker compose.
# Copy to `.env` and edit. NEVER commit the real .env.

# --- general ---
APP_ENV=production
DEBUG=false
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-secret
# Origin(s) allowed by CORS. Comma-separate multiple.
FRONTEND_ORIGIN=http://localhost:8080
# Set to true when serving over HTTPS.
COOKIE_SECURE=false

# --- database ---
POSTGRES_USER=resumo
POSTGRES_PASSWORD=resumo
POSTGRES_DB=resumo

# --- storage: local | s3 ---
STORAGE_BACKEND=local
S3_BUCKET=
S3_REGION=ap-south-1

# --- AI (optional): none | ollama | openai | bedrock ---
LLM_PROVIDER=none
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:1.5b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
BEDROCK_REGION=ap-south-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
